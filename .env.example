# --- Telegram API (my.telegram.org -> API development tools) ---
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# --- Строка сессии: python scripts/gen_session.py ---
SESSION=

# --- Приватный канал/чат для логов. Можно "me" (Saved Messages) ---
LOG_CHAT=me

# --- Префикс команд ---
PREFIX=.

# --- Хранилище ---
DB_PATH=data/guard.sqlite3
CACHE_TTL_HOURS=48
DELETED_TTL_DAYS=30
MAX_MEDIA_MB=25

# --- Поведение по умолчанию для новых чатов ---
DEFAULT_ANTIDELETE=1        # 1 = логировать удалённые (только в личках, см. ANTIDELETE_GROUPS)
DEFAULT_LOG_EDITS=1
DEFAULT_SAVE_MEDIA=1
ANTIDELETE_GROUPS=0         # 1 = включать антиудаление и в группах тоже
LOG_OWN=0                   # 1 = логировать и свои удалённые/изменённые сообщения

# --- Анимация .mute: bar | type | off ---
MUTE_ANIM=type
ANIM_DELAY=0.4
MUTE_LOG=1                  # 1 = писать в лог-чат то, что удалил мут

# --- Бэкап БД в LOG_CHAT (минуты, 0 = выключить). Обязателен на хостах с эфемерным диском ---
BACKUP_EVERY_MIN=60
RESTORE_ON_START=1

# --- HTTP healthcheck (нужен бесплатным web-тарифам Render/Koyeb) ---
PORT=8080
