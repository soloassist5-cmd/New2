# ============================================================================
#  Режим 1 — Telegram Business (рекомендуемый). Нужен только токен бота.
#  Бот подключается в Настройки -> Telegram для бизнеса -> Чат-боты
#  и получает события личных чатов, включая удаления. Нужен Telegram Premium.
# ============================================================================
BOT_TOKEN=

# Telegram id АДМИНИСТРАТОРА бота — того, кто его развернул. Задать обязательно,
# если бот будет не только вашим:
#   * только администратор решает, кого пускать (кнопки «Принять»/«Отклонить»);
#   * только он видит /users, /revoke и базу целиком;
#   * только зная его id, бот при старте забирает закреплённый в его личке
#     бэкап и поднимает базу после передеплоя.
# Где взять: бот подскажет в /start, либо команда .id в любом личном чате.
# Остальные пользователи добавляются прямо в боте, в переменных их указывать не надо.
# Если оставить пустым, возьмётся FALLBACK_OWNER_ID из config.py — id
# администратора текущей установки. Разворачиваете бота для себя — впишите свой.
OWNER_ID=

# ============================================================================
#  Режим 2 — юзербот (необязательный). Добавляет группы, но это серая зона
#  правил Telegram. Нужен, только если Premium нет или важны групповые чаты.
# ============================================================================
API_ID=
API_HASH=
SESSION=

# Куда юзербот складывает копии медиа. "me" = Избранное.
# В режиме Business не используется: там медиа берётся по file_id.
LOG_CHAT=me

# ============================================================================
#  Общие настройки
# ============================================================================
PREFIX=.

DB_PATH=data/guard.sqlite3
CACHE_TTL_HOURS=48
DELETED_TTL_DAYS=30
MAX_MEDIA_MB=25

DEFAULT_ANTIDELETE=1        # логировать удалённые (по умолчанию только в личках)
DEFAULT_LOG_EDITS=1
DEFAULT_SAVE_MEDIA=1
ANTIDELETE_GROUPS=0         # 1 = включить антиудаление и в группах (только юзербот)
LOG_OWN=0                   # 1 = логировать и свои удалённые/изменённые сообщения

# Анимация .mute: type | bar | off
MUTE_ANIM=type
ANIM_DELAY=0.4
# Перехваченное всегда копится в журнале (.muted, /intercepted, сводка при
# снятии мута). Этот флаг включает ещё и мгновенное уведомление на каждое
# сообщение — по умолчанию выключен, иначе замученный собеседник переезжает
# в личку с ботом.
MUTE_LOG=0

# Режим «не беспокоить» (кнопка в /menu, .gmute, /gmute) включается вручную,
# срока у него нет. Здесь — что бот отвечает от вашего имени; оставьте пустым,
# чтобы взять текст по умолчанию.
DND_TEXT=
DND_REPLY_COOLDOWN=3600     # не чаще раза в час на одного человека

# Массовое удаление (собеседник очистил переписку): от скольких сообщений
# присылать одну сводку с файлом вместо отдельных карточек.
PURGE_THRESHOLD=5
PURGE_DEBOUNCE_SEC=3        # окно, за которое пачки удалений складываются в одну
PURGE_MEDIA_LIMIT=10        # сколько вложений досылать следом за файлом

# Бэкап базы (минуты, 0 = выключить). Обязателен на хостах с эфемерным диском.
BACKUP_EVERY_MIN=60
RESTORE_ON_START=1

# HTTP-сервер: бесплатные тарифы дают только web service, слушать $PORT обязательно
PORT=8080

# Публичный адрес сервиса. Задан -> бот работает через вебхук вместо long polling;
# для web-тарифов это правильный режим. На Render подставляется автоматически
# (RENDER_EXTERNAL_URL), вручную указывать не нужно.
WEBHOOK_URL=
# Необязательно: секрет для проверки запросов Telegram. Пусто -> выводится из токена.
WEBHOOK_SECRET=
